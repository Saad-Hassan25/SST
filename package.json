{
  "name": "sst-prompter",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs && python -m unittest discover -s tests -p test_*.py",
    "test:browser": "node tests/browser-smoke.cjs",
    "dev:worker": "wrangler dev --config worker/wrangler.toml --port 8787",
    "check:worker": "wrangler deploy --config worker/wrangler.toml --dry-run --outdir .wrangler/build"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "wrangler": "4.86.0"
  }
}
